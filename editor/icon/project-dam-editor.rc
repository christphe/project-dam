/* Windows executable icon of the editor (Explorer / taskbar).
 * The project mark on a blueprint grid, generated by tools_pc/make_icon.py
 * (editor/icon/project-dam-editor.ico). */
IDI_ICON1 ICON "project-dam-editor.ico"

/* UTF-8 as the ANSI code page: paths with accents (cmake/win/utf8.manifest). 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST. */
1 24 "../../cmake/win/utf8.manifest"
