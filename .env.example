# Local machine settings, read by the repo's tools (tools_pc/seaview/seaview.py, ...).
# Copy this file to .env at the repo root and fill it in. .env is ignored by git: never commit it.

# The console's address on the local network, for nxlink (hbmenu, netloader).
SWITCH_IP=192.168.0.2

# The Switch emulator used for the screenshot / capture runs, and the root of its virtual SD card.
SWITCH_EMU_EXE=C:\path\to\switch-emulator.exe
SWITCH_EMU_SD=C:\path\to\switch-emulator\sdcard

# An N64 emulator, for reference captures.
N64_EMU_EXE=C:\path\to\n64-emulator.exe

# Your ROM: the .z64 the N64 emulator opens (tools/dev.py n64), copied into the native builds' data/, and the
# one every tool reads (tools/dev.py tools: modelview, fxview, disasm...).
N64_ROM=C:\path\to\GoldenEye 007 (USA).z64

# The Docker image the Switch build runs in (docker compose build).
DOCKER_IMAGE=local/project-dam-build:latest

# A Windows g++ (MinGW-w64) the viewers build with (seaview, menuview, modelview, fxview).
# Optional when MSYS2 is installed in C:\msys64.
SEAVIEW_GXX=C:\path\to\mingw64\bin\g++.exe
