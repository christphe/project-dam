# The sea tab's level environment records, taken from the game's own table (issue #145): script mode (-P) with SEA_SRC (repo) and
# SEA_OUT (the .inc to write). Cuts the two tables of src/game/bgfog.c (the non-EU `fog_tables`, `fog_tables2`) out of the source
# text, so a change of the game's data reaches the tool at the next build; sea_env.c compiles them with the game's own headers.
file(READ "${SEA_SRC}/src/game/bgfog.c" _t)
# the last `fog_tables` is the non-EU one (the #else branch); the EU table comes first under #if defined(VERSION_EU)
string(FIND "${_t}" "EnvironmentRecord fog_tables[] = {" _first)
string(SUBSTRING "${_t}" ${_first} -1 _rest)
string(FIND "${_rest}" "\n};" _end)
string(SUBSTRING "${_rest}" 0 ${_end} _eu)   # the EU table
string(LENGTH "${_eu}" _eul)
math(EXPR _skip "${_eul} + 3")
string(SUBSTRING "${_rest}" ${_skip} -1 _rest2)
string(FIND "${_rest2}" "EnvironmentRecord fog_tables[] = {" _second)
string(SUBSTRING "${_rest2}" ${_second} -1 _us)
string(FIND "${_us}" "\n};" _end2)
string(SUBSTRING "${_us}" 0 ${_end2} _us)
string(REPLACE "EnvironmentRecord fog_tables[] = {" "static const EnvironmentRecord s_fog_tables[] = {" _us "${_us}")
string(FIND "${_t}" "EnvironmentFoglessRecord fog_tables2[] = {" _f2)
string(SUBSTRING "${_t}" ${_f2} -1 _fl)
string(FIND "${_fl}" "\n};" _end3)
string(SUBSTRING "${_fl}" 0 ${_end3} _fl)
string(REPLACE "EnvironmentFoglessRecord fog_tables2[] = {" "static const EnvironmentFoglessRecord s_fog_tables2[] = {" _fl "${_fl}")
file(WRITE "${SEA_OUT}" "/* generated by sea_env.cmake from src/game/bgfog.c: the game's environment records */\n${_us}\n};\n\n${_fl}\n};\n")
