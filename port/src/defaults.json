      "eq": 1
     }
    },
    {
     "key": "Input.PadPreset4",
     "set": 0,
     "when": {
      "key": "Input.ControlScheme",
      "eq": 1
     }
    },
    {
     "key": "Input.ControlScheme2",
     "set": 0,
     "when": {
      "key": "Input.ControlScheme",
      "eq": 0
     }
    },
    {
     "key": "Input.ControlScheme2",
     "set": 1,
     "when": {
      "key": "Input.ControlScheme",
      "eq": 1
     }
    },
    {
     "key": "Input.ControlScheme3",
     "set": 0,
     "when": {
      "key": "Input.ControlScheme",
      "eq": 0
     }
    },
    {
     "key": "Input.ControlScheme3",
     "set": 1,
     "when": {
      "key": "Input.ControlScheme",
      "eq": 1
     }
    },
    {
     "key": "Input.ControlScheme4",
     "set": 0,
     "when": {
      "key": "Input.ControlScheme",
      "eq": 0
     }
    },
    {
     "key": "Input.ControlScheme4",
     "set": 1,
     "when": {
      "key": "Input.ControlScheme",
      "eq": 1
     }
    },
    {
     "key": "Input.ControlScheme",
     "set": 2,
     "when": {
      "key": "Input.PadPreset",
      "eq": 5
     }
    },
    {
     "key": "Input.PadPreset",
     "set": 0,
