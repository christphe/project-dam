      "eq": 5
     }
    },
    {
     "key": "Input.PadPreset3",
     "set": 0,
     "when": {
      "key": "Input.PadPreset3",
      "eq": 5
     }
    },
    {
     "key": "Input.ControlScheme4",
     "set": 2,
     "when": {
      "key": "Input.PadPreset4",
      "eq": 5
     }
