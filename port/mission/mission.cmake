# Custom co-op missions (issues #100-#104): the mission library.
# Owned by the missions-in-game track (mission lib, setup apply, Luau runtime).
# Plain host C/C++: its own static target, without the decomp's shadow headers
# (port/shim, include/ have an N64 stdlib.h/math.h) or the forced
# versioninfo.h, like ge_volk. The game links it; so do the tests and the
# editor. Game-side glue that needs game headers goes in port/src/ instead.
set(GE_LUAU "${CMAKE_SOURCE_DIR}/port/third_party/luau")

# The Luau VM + compiler (MIT, Roblox; port/third_party/luau, no Analysis / CodeGen / CLI).
file(GLOB GE_LUAU_SRC CONFIGURE_DEPENDS
  "${GE_LUAU}/VM/src/*.cpp"
  "${GE_LUAU}/Compiler/src/*.cpp"
  "${GE_LUAU}/Ast/src/*.cpp"
  "${GE_LUAU}/Bytecode/src/*.cpp"
  "${GE_LUAU}/Common/src/*.cpp")

# The built-in mission scripts (port/mission/lib/*.luau) embedded as C strings:
# g_missionLibScripts. Generated at configure time; editing a script re-runs cmake.
file(GLOB GE_MISSION_LIB CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/port/mission/lib/*.luau")
set(GE_MISSION_LIB_C "${CMAKE_BINARY_DIR}/port/mission/mission_libscripts.c")
set(_lib_c "/* generated by port/mission/mission.cmake from port/mission/lib/*.luau */\n#include \"mission_lua.h\"\n")
set(_lib_tab "const MissionLibScript g_missionLibScripts[] = {\n")
foreach(_f ${GE_MISSION_LIB})
  get_filename_component(_n "${_f}" NAME_WE)
  file(READ "${_f}" _hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  string(APPEND _lib_c "static const unsigned char src_${_n}[] = {${_bytes}0x00};\n")
  string(APPEND _lib_tab "  { \"${_n}\", (const char *)src_${_n} },\n")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_f}")
endforeach()
string(APPEND _lib_tab "  { 0, 0 }\n};\n")
file(WRITE "${GE_MISSION_LIB_C}.tmp" "${_lib_c}${_lib_tab}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${GE_MISSION_LIB_C}.tmp" "${GE_MISSION_LIB_C}")

add_library(ge_mission STATIC
  "${CMAKE_SOURCE_DIR}/port/mission/mission.c"
  "${CMAKE_SOURCE_DIR}/port/mission/mission_apply.c"
  "${CMAKE_SOURCE_DIR}/port/mission/mission_dir.c"
  "${CMAKE_SOURCE_DIR}/port/mission/mission_lua.cpp"
  "${GE_MISSION_LIB_C}"
  "${CMAKE_SOURCE_DIR}/port/third_party/cjson/cJSON.c"
  ${GE_LUAU_SRC}
)
set_property(TARGET ge_mission PROPERTY INCLUDE_DIRECTORIES
  "${CMAKE_SOURCE_DIR}/port/mission"
  "${CMAKE_SOURCE_DIR}/port/levelrec"
  "${CMAKE_SOURCE_DIR}/port/third_party/cjson"
  "${GE_LUAU}/VM/include" "${GE_LUAU}/VM/src"
  "${GE_LUAU}/Compiler/include" "${GE_LUAU}/Compiler/src"
  "${GE_LUAU}/Ast/include" "${GE_LUAU}/Bytecode/include" "${GE_LUAU}/Common/include")
set_property(TARGET ge_mission PROPERTY COMPILE_OPTIONS "")
set_property(TARGET ge_mission PROPERTY CXX_STANDARD 17)
set_property(TARGET ge_mission PROPERTY CXX_STANDARD_REQUIRED ON)
set(SRC_MISSION "")

# MinGW: the game defines isalpha / isspace / toupper itself (src/str.c). Luau's ctype calls would pull the
# CRT import thunks of the same names (libmsvcrt.a, via dllimport) into the link: a duplicate definition.
# Plain (non-dllimport) declarations bind them to the game's own, which behave the same on ASCII.
if(WIN32)
  target_compile_definitions(ge_mission PRIVATE "_CRTIMP=")
endif()

# devkitA64 (newlib): lbuiltins.cpp uses LLONG_MIN without including <climits>; a forced include keeps the vendored tree unmodified.
target_compile_options(ge_mission PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:SHELL:-include climits>")
