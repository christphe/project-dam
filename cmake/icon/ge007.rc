/* Windows executable icon (Explorer / taskbar).
 * Original crosshair mark generated by tools_pc/make_icon.py (cmake/icon/
 * ge007.ico) -- same art as the site favicon (docs/img/icon/). */
IDI_ICON1 ICON "ge007.ico"

/* UTF-8 as the ANSI code page: paths with accents (cmake/win/utf8.manifest). 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST. */
1 24 "../win/utf8.manifest"
