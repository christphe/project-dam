# project-dam: Linux aarch64 cross-compilation for Allwinner H700 handhelds
# (Anbernic RG34XX / RG35XX family) running muOS.
#
#   docker compose build h700           # once
#   docker compose run --rm h700        # -> build-h700/ge007.aarch64
#
# Debian bookworm = glibc 2.36, the floor muOS's 64-bit userspace provides, so
# the binary runs on the device's own libc. SDL2 is linked by soname only
# (libSDL2-2.0.so.0): at run time the firmware's SDL2 is used, the one with the
# Mali fbdev video driver. GL is not linked at all: muOS has only the libmali
# GLES blob, and glad resolves every GL entry point through SDL_GL_GetProcAddress.
# Base image pinned by digest; bump deliberately. No game files are copied in.
FROM docker.io/library/debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

RUN dpkg --add-architecture arm64 \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ccache \
        cmake \
        crossbuild-essential-arm64 \
        git \
        ninja-build \
        python3 \
        libsdl2-dev:arm64 \
        zlib1g-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

ENV CCACHE_DIR=/ccache \
    CCACHE_MAXSIZE=5G \
    CCACHE_BASEDIR=/src \
    CCACHE_NOHASHDIR=1

RUN git config --system --add safe.directory '*'
WORKDIR /src
